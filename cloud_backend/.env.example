# ========================================================
# HellGuardian Cloud Backend Configuration
# ========================================================

# Secure Secret Key for Ingestion (Must match publisher agent)
INGEST_API_KEY=hg_sec_token_9f82d1a4e76c

# Database connection:
# SQLite (Local file): sqlite:///./hellguardian_cloud.db
# PostgreSQL (Supabase / Render / Neon): postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./hellguardian_cloud.db

# Seconds before sensor node is marked offline after last heartbeat (default 300s = 5m)
OFFLINE_TIMEOUT_SECONDS=300

# Server Binding
HOST=0.0.0.0
PORT=8090

# Optional Enrichment Keys
VIRUSTOTAL_API_KEY=
GEMINI_API_KEY=
